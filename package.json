{
  "name": "reskin-mockups",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sample": "node scripts/make-sample-psd.mjs",
    "inspect": "node scripts/inspect-psd.mjs",
    "postinstall": "node scripts/patch-ag-psd.mjs"
  },
  "dependencies": {
    "ag-psd": "^28.5.1",
    "fflate": "^0.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  },
  "description": "Browser-based PSD mockup tool: replace the design, recolor the product, and bulk-export variations.",
  "engines": {
    "node": ">=20"
  }
}
